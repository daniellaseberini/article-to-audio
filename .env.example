# Copy this file to .env and fill in your real key — .env is git-ignored and never committed.

# Required. Get yours at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Defaults to the premade "Rachel" voice if not set.
# Find voice IDs at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# Optional. Local server port.
PORT=5050
